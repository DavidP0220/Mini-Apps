{
  "_comentario": "Modelo por defecto para este proyecto. Es HTML/CSS/JS puro sin dependencias: Sonnet basta y cuesta 5 veces menos que Opus. Para arquitectura o depuracion dificil, cambia con /model opus dentro de la sesion.",
  "model": "claude-sonnet-5",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(node tools/new-app.mjs:*)",
      "Bash(node tools/token-report.mjs:*)",
      "Bash(node tools/router/listar-modelos-gratis.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(//home/user/Mini-Apps/**)",
      "Bash(node tools/content.mjs:*)",
      "Bash(node tools/sync-motor.mjs:*)",
      "Bash(node human-chronicles/tools/hc.mjs:*)",
      "Bash(node human-chronicles/tools/buscar-archivo.mjs:*)",
      "Bash(git check-ignore:*)",
      "Bash(ffprobe:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.claude-code-router/config.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/hooks/aviso-content.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node tools/hooks/statusline.mjs"
  }
}